field = reshape(response, 1, 1, $samples)
field = conv(field, 16, kernel_size=(1,15), stride=(1,4), padding=(0,7), name="audio0")
field = silu(field)
field = conv(field, 16, kernel_size=(1,15), stride=(1,4), padding=(0,7), name="audio2")
field = silu(field)
field = reshape(field, 16, -1)
field = mean(field, 2)
context = linear(condition, 32, name="condition")
gain, bias = split(context, 16)
ones = constant(gain, 16, value=1.0)
gain = add(gain, ones)
field = mul(field, gain)
field = add(field, bias)
field = silu(field)
linear(field, 1, name="score")
